<ui:FluentWindow x:Class="Il2CppDumperEx.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Il2CppDumperEx"
                 Icon="pack://application:,,,/Il2CppDumperEx;component/Assets/Icon.ico"
                 Width="880" Height="720"
                 MinWidth="880" MaxWidth="880"
                 MinHeight="720" MaxHeight="720"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="#16161A"
                 AllowDrop="True"
                 DragEnter="Window_DragEnter"
                 DragOver="Window_DragOver"
                 DragLeave="Window_DragLeave"
                 Drop="Window_Drop"
                 Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Row 0: Native TitleBar -->
            <RowDefinition Height="*" />     <!-- Row 1: Main Application Content -->
            <RowDefinition Height="Auto" />  <!-- Row 2: Status Bar -->
        </Grid.RowDefinitions>

        <!-- Windows 11 Native Fluent TitleBar with App Icon (Close button only) -->
        <ui:TitleBar Grid.Row="0"
                     Title="Il2CppDumperEx"
                     ShowMaximize="False"
                     CanMaximize="False"
                     ShowMinimize="False"
                     ShowClose="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Il2CppDumperEx;component/Assets/Icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="14,4,14,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- 0: Target & Output Card -->
                <RowDefinition Height="Auto" />  <!-- 1: Advanced Options Card -->
                <RowDefinition Height="Auto" />  <!-- 2: Progress & Actions Card -->
                <RowDefinition Height="*" />     <!-- 3: Activity Log Card -->
            </Grid.RowDefinitions>

            <!-- Row 0: Target & Output Card (Unified Drag & Drop Area) -->
            <ui:Card x:Name="TargetCard" Grid.Row="0" Margin="0,0,0,8" Padding="12,10"
                     Background="#1E1E24" BorderBrush="#2D2D36" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="276" />
                    </Grid.ColumnDefinitions>

                    <!-- Game Target Row -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Game Target" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" Foreground="#F4F4F5" />
                    <ui:TextBox x:Name="TxtGamePath" Grid.Row="0" Grid.Column="1" Height="34" Margin="0,0,8,0"
                                PlaceholderText="Select executable (.exe) or game folder"
                                ClearButtonEnabled="True"
                                ToolTip="Select game executable, game root directory, or &lt;Game&gt;_Data folder (or drag &amp; drop here)" />
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                        <ui:Button x:Name="BtnBrowseExe" Content="Select File..."
                                   Icon="{ui:SymbolIcon Symbol=AppGeneric24}"
                                   Appearance="Secondary"
                                   Height="34" Width="132" Margin="0,0,6,0" Click="BtnBrowseExe_Click" />
                        <ui:Button x:Name="BtnBrowseFolder" Content="Select Folder..."
                                   Icon="{ui:SymbolIcon Symbol=Folder24}"
                                   Appearance="Secondary"
                                   Height="34" Width="138" Click="BtnBrowseFolder_Click" />
                    </StackPanel>

                    <!-- Output Directory Row -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Output Dir" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" Foreground="#F4F4F5" Margin="0,8,0,0" />
                    <ui:TextBox x:Name="TxtOutputDir" Grid.Row="1" Grid.Column="1" Height="34" Margin="0,8,8,0"
                                PlaceholderText="Auto-generated from game target"
                                ClearButtonEnabled="True"
                                ToolTip="Destination directory for decompiled files (auto-generated from target)" />
                    <ui:Button x:Name="BtnBrowseOutput" Grid.Row="1" Grid.Column="2" Content="Select Output Directory..."
                               Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                               Appearance="Secondary"
                               Height="34" Width="276" Margin="0,8,0,0" Click="BtnBrowseOutput_Click" />
                </Grid>
            </ui:Card>

            <!-- Row 1: Options Card (CardExpander) with Single Shared Grid -->
            <ui:CardExpander x:Name="ExpAdvanced" Grid.Row="1" Margin="0,0,0,8"
                             Icon="{ui:SymbolIcon Symbol=Settings24}"
                             ContentPadding="12,10"
                             Background="#1E1E24" BorderBrush="#2D2D36" BorderThickness="1"
                             IsExpanded="False">
                <ui:CardExpander.Header>
                    <TextBlock Text="Metadata version &amp; options" FontWeight="SemiBold" FontSize="12.5" Foreground="#F4F4F5" />
                </ui:CardExpander.Header>

                <!-- Single Shared Options Grid with 4 Columns -->
                <Grid Margin="0,2,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />  <!-- Col 0: Fixed Group Label -->
                        <ColumnDefinition Width="*" />    <!-- Col 1: Equal Width Checkbox 1 -->
                        <ColumnDefinition Width="*" />    <!-- Col 2: Equal Width Checkbox 2 -->
                        <ColumnDefinition Width="*" />    <!-- Col 3: Equal Width Checkbox 3 -->
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- Row 0: Metadata version -->
                        <RowDefinition Height="Auto" />  <!-- Row 1: Output files -->
                        <RowDefinition Height="Auto" />  <!-- Row 2: Dump content (Line 1) -->
                        <RowDefinition Height="Auto" />  <!-- Row 3: Dump content (Line 2) -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Metadata Version Selection -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Metadata version:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="#F4F4F5" Margin="0,0,6,0" />
                    <ComboBox x:Name="CmbForceVersion" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                              Height="32" Width="260" HorizontalAlignment="Left"
                              VerticalContentAlignment="Center" Padding="8,4"
                              ToolTip="Auto-detect (recommended) or choose a specific metadata version supported by the engine." />

                    <!-- Row 1: Output Files -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Output files:" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11.5"
                               Foreground="#A1A1AA" Margin="0,8,6,0" />
                    <CheckBox x:Name="ChkDummyDll" Grid.Row="1" Grid.Column="1" Content="Dummy DLLs" IsChecked="True" VerticalAlignment="Center" Margin="0,8,6,0" />
                    <CheckBox x:Name="ChkDumpCs" Grid.Row="1" Grid.Column="2" Content="C# (dump.cs)" IsChecked="True" VerticalAlignment="Center" Margin="0,8,6,0" />
                    <CheckBox x:Name="ChkStruct" Grid.Row="1" Grid.Column="3" Content="Headers (il2cpp.h)" IsChecked="True" VerticalAlignment="Center" Margin="0,8,0,0"
                              ToolTip="Generates il2cpp.h (C++ structures) and script.json (symbol mappings for IDA/Ghidra)" />

                    <!-- Row 2: Dump Content Line 1 -->
                    <TextBlock Grid.Row="2" Grid.RowSpan="2" Grid.Column="0" Text="Dump content:" VerticalAlignment="Top" FontWeight="SemiBold" FontSize="11.5"
                               Foreground="#A1A1AA" Margin="0,10,6,0" />
                    <CheckBox x:Name="ChkDumpMethod" Grid.Row="2" Grid.Column="1" Content="Methods" IsChecked="True" VerticalAlignment="Center" Margin="0,8,6,0" />
                    <CheckBox x:Name="ChkDumpMethodOffset" Grid.Row="2" Grid.Column="2" Content="Method offsets" IsChecked="True" VerticalAlignment="Center" Margin="0,8,6,0" />
                    <CheckBox x:Name="ChkDumpField" Grid.Row="2" Grid.Column="3" Content="Fields" IsChecked="True" VerticalAlignment="Center" Margin="0,8,0,0" />

                    <!-- Row 3: Dump Content Line 2 -->
                    <CheckBox x:Name="ChkDumpFieldOffset" Grid.Row="3" Grid.Column="1" Content="Field offsets" IsChecked="True" VerticalAlignment="Center" Margin="0,6,6,0" />
                    <CheckBox x:Name="ChkDumpProperty" Grid.Row="3" Grid.Column="2" Content="Properties" IsChecked="True" VerticalAlignment="Center" Margin="0,6,6,0" />
                    <CheckBox x:Name="ChkDumpAttribute" Grid.Row="3" Grid.Column="3" Content="Attributes" IsChecked="True" VerticalAlignment="Center" Margin="0,6,0,0" />
                </Grid>
            </ui:CardExpander>

            <!-- Row 2: Progress & Primary Actions -->
            <ui:Card Grid.Row="2" Margin="0,0,0,8" Padding="14,12"
                     Background="#1E1E24" BorderBrush="#2D2D36" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Step Header: Step Number / Status (Left) & Current Task Description (Right) -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <ui:ProgressRing x:Name="PrgRing" Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True" Visibility="Collapsed" />
                            <TextBlock x:Name="LblStepNumber" Text="Ready" FontWeight="SemiBold" FontSize="12.5" Foreground="#F4F4F5" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="LblStepDetails" Text="Select game target and click Start Dump" FontSize="12"
                                   Foreground="#A1A1AA"
                                   HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- Enhanced Progress Bar (14px height, smooth animation, state colors) -->
                    <ProgressBar x:Name="PrgBar" Grid.Row="1" Height="14" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,12" />

                    <!-- Action Buttons Row -->
                    <DockPanel Grid.Row="2">
                        <ui:Button x:Name="BtnOpenOutput" Content="Open Output Folder"
                                   Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                   Appearance="Secondary"
                                   Height="34" Width="180" Visibility="Collapsed" Click="BtnOpenOutput_Click" DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <ui:Button x:Name="BtnCancel" Content="Cancel"
                                       Icon="{ui:SymbolIcon Symbol=Dismiss24}"
                                       Appearance="Danger"
                                       Height="34" Width="95" Margin="0,0,8,0" IsEnabled="False" Click="BtnCancel_Click" />
                            <ui:Button x:Name="BtnStart" Content="Start Dump"
                                       Icon="{ui:SymbolIcon Symbol=Play24}"
                                       Appearance="Primary"
                                       Height="34" Width="130" Click="BtnStart_Click" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </ui:Card>

            <!-- Row 3: Activity Log Console (Virtualized, Read-Only, Distinct Border & Surface) -->
            <ui:Card Grid.Row="3" Padding="14,12" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                     Background="#1E1E24" BorderBrush="#2D2D36" BorderThickness="1">
                <Grid VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Log Header & Action Buttons -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DocumentBulletList24" Margin="0,0,6,0" Foreground="#F4F4F5" />
                            <TextBlock Text="Activity Log" FontWeight="SemiBold" FontSize="12.5" Foreground="#F4F4F5" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="LblToast" Text="Copied to clipboard!" Foreground="#22C55E" FontWeight="SemiBold"
                                       FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed" />
                            <ui:Button x:Name="BtnCopyLog" Content="Copy Log"
                                       Icon="{ui:SymbolIcon Symbol=Copy24}"
                                       Appearance="Secondary"
                                       Height="30" Width="110" Margin="0,0,6,0" Click="BtnCopyLog_Click" />
                            <ui:Button x:Name="BtnClearLog" Content="Clear"
                                       Icon="{ui:SymbolIcon Symbol=Delete24}"
                                       Appearance="Secondary"
                                       Height="30" Width="85" Click="BtnClearLog_Click" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Custom Virtualized Log View inside a distinct rounded border container -->
                    <Border Grid.Row="1" CornerRadius="6" BorderBrush="#2D2D36" BorderThickness="1" Background="#111114" Padding="0">
                        <ListBox x:Name="LstLog"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Focusable="False"
                                 FocusVisualStyle="{x:Null}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 Padding="10,8,10,14"
                                 MinHeight="100"
                                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                    <Setter Property="Padding" Value="2,1" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RawText}" Foreground="{Binding ForegroundBrush}"
                                               FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                                               FontSize="11.5"
                                               TextWrapping="NoWrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </ui:Card>
        </Grid>

        <!-- Row 2: Status Bar (Height 32, slate surface color, subtle top divider) -->
        <Border Grid.Row="2" Height="32" Background="#18181D" BorderBrush="#2D2D36" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />  <!-- State (Dot + Text) -->
                    <ColumnDefinition Width="*" />     <!-- Version Info (Centered) -->
                    <ColumnDefinition Width="Auto" />  <!-- Elapsed Timer -->
                </Grid.ColumnDefinitions>

                <!-- Left: Status Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" FontWeight="Medium" Foreground="#F4F4F5" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Detected Versions -->
                <TextBlock x:Name="StatusVersions" Grid.Column="1" Text="Unity: Auto-detect  •  Metadata: Auto-detect"
                           FontSize="12" Foreground="#A1A1AA"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Right: Elapsed Timer -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Timer24" FontSize="14" Margin="0,0,6,0" Foreground="#A1A1AA" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusTimer" Text="00:00:00" FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"
                               Foreground="#F4F4F5" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
